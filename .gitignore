# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# photo originals: only collection.json files and the manifest are committed
/content/collections/*/photos/*
!/content/collections/*/photos/.gitkeep
# local-only derivatives from `npm run ingest -- --storage=local`
/public/media

# build brief (private)
/PORTFOLIO_SPEC.md

# editor/agent local config
/.claude

# originals dropped in for sorting (never committed)
/uploaded-photos
